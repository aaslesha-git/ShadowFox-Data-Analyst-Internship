rtoon\",\"80s-glam\",\"art-nouveau\",\"synthwave\"]},\"is_device_based\":false,\"passed\":false},\"2562735250\":{\"name\":\"2562735250\",\"rule_id\":\"1VxIWEnabUnUYnLrNXj42u:100.00:18-1VxIWCI7JCeqEYdwcPnqJs\",\"secondary_exposures\":[{\"gate\":\"3006008350\",\"gateValue\":\"true\",\"ruleID\":\"7qa92Sc3hwYJC1yMLU9mVq:100.00:3\"}],\"version\":146,\"id_type\":\"userID\",\"value\":{\"native_plugins_v2\":true,\"nav_enabled\":true,\"settings_enabled\":true,\"composer_enabled\":true,\"native_settings_enabled\":true,\"skills_enabled\":true,\"redirect_enabled\":true,\"enabled\":true},\"is_device_based\":false,\"passed\":true},\"111706139\":{\"name\":\"111706139\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"444232970\",\"gateValue\":\"false\",\"ruleID\":\"gbNhJYZt2LT0MMPpBwPnn\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"loginStrategy\":\"existing_user\",\"name\":\"microsoft\",\"tempDisabled\":false,\"enabled\":true,\"kind\":\"social\"},\"is_device_based\":false,\"passed\":false},\"1165494509\":{\"name\":\"1165494509\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":21,\"id_type\":\"userID\",\"value\":{\"kind\":\"username\",\"loginStrategy\":\"existing_user\",\"enabled\":true,\"name\":\"phone_number\",\"tempDisabled\":false},\"is_device_based\":false,\"passed\":false},\"3586972587\":{\"name\":\"3586972587\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"userID\",\"value\":{\"prompt\":\"The user provided feedback on a previous completion. Use it to generate a new completion. The output should be a standalone response that reflects the feedback without acknowledging it. Do not mention, suggest, or imply that this is a revision, improvement, or result of feedback. Respond in the same language as the original completion, even if the feedback is in another language. Only switch if the feedback explicitly asks you to translate the completion. Here is the feedback:\\n\"},\"is_device_based\":false,\"passed\":false},\"2303287315\":{\"name\":\"2303287315\",\"rule_id\":\"launchedGroup\",\"secondary_exposures\":[],\"version\":17,\"id_type\":\"userID\",\"value\":{\"sidepanel_enabled\":true},\"is_device_based\":false,\"group_name\":\"Test\",\"is_experiment_active\":false,\"is_user_in_experiment\":false},\"1299917208\":{\"name\":\"1299917208\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":11,\"id_type\":\"stableID\",\"value\":{\"handoff_link_strategy\":\"legacy_root\"},\"is_device_based\":true,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"193245580\":{\"name\":\"193245580\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"cli\":\"https://developers.openai.com/codex/cli\",\"vscodeExtensionAppId\":\"openai.chatgpt\",\"windsurfExtensionAppId\":\"openai.chatgpt\",\"cursorExtensionAppId\":\"openai.chatgpt\",\"cursor\":\"cursor:extension/openai.chatgpt\",\"windsurf\":\"windsurf:extension/openai.chatgpt\",\"vscode\":\"vscode:extension/openai.chatgpt\"},\"is_device_based\":false,\"passed\":false},\"3075710337\":{\"name\":\"3075710337\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":29,\"id_type\":\"userID\",\"value\":{\"connector_68e004f14af881919eb50893d3d9f523\":7,\"connector_68de829bf7648191acd70a907364c67c\":1,\"connector_69272cb413a081919685ec3c88d1744e\":6,\"connector_68df33b1a2d081918778431a9cfca8ba\":5,\"connector_68d579f7b0948191a7da3124a3b560f7\":2,\"connector_68e01e8c1c2081918b4567a0b959d3ff\":3,\"connector_68f1afc5a6008191a701eaaab428816c\":6,\"connector_68df038e0ba48191908c8434991bbac2\":4,\"connector_68f1abff1b688191b9309a31c9b4a713\":6},\"is_device_based\":false,\"passed\":false},\"3075814186\":{\"name\":\"3075814186\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"connectors\":[\"connector_8cbe1e9e357f4ec79fa9f1a8aa78f4c1\",\"connector_fdb98b59c8d44f678b086d20e82bd316\",\"connector_1ee51bd730c272434e1b17c46f8a2397\",\"connector_4886707321be47efb8b9369ebb877881\",\"connector_da257d66000a45c683fe44e411037409\",\"connector_f317b2c679f84ad5b6f2af12fb6f609a\",\"connector_cfcd99fd238d43c888544acd294b3f31\",\"connector_36803b8cc4164d84aa3fbfc7ddb420e1\",\"connector_97fbcfe6da0d4a4282ebb47f6e01e