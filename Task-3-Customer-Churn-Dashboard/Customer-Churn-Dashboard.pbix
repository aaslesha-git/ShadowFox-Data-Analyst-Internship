6px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="97e2935d-c107-4414-8750-cc1df6c3291e" data-is-intersecting="false" style="--last-known-height: 131.96739196777344px; --estimated-turn-height: 74px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-7" data-is-intersecting="false" style="--last-known-height: 2862.684814453125px; --estimated-turn-height: 2576px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="82a1b1af-f656-4af2-a570-0d2dae1e1231" data-is-intersecting="false" style="--last-known-height: 131.96739196777344px; --estimated-turn-height: 74px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-8" data-is-intersecting="false" style="--last-known-height: 2430.33251953125px; --estimated-turn-height: 2162px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="968e017f-c829-4f90-9cec-2cde58e63724" data-is-intersecting="false" style="--last-known-height: 131.96739196777344px; --estimated-turn-height: 74px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-9" data-is-intersecting="false" style="--last-known-height: 2908.839111328125px; --estimated-turn-height: 2666px;"></div><div class="h-[var(--last-known-height,var(--estimated-turn-height,50vh))] min-h-14" data-turn-id-container="dca9a435-a0e3-47ab-9460-bb272f23a89c" data-is-intersecting="false" style="--last-known-height: 131.96739196777344px; --estimated-turn-height: 74px;"></div><div class="" data-turn-id-container="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-10" data-is-intersecting="true"><section class="text-token-text-primary w-full focus:outline-none has-data-writing-block:pointer-events-none [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]" dir="auto" data-turn-id="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-10" data-turn-id-container="request-WEB:6097eac3-47b1-4f33-824d-cd1eb5b6292b-10" data-testid="conversation-turn-22" data-turn="assistant"><h4 class="sr-only select-none">ChatGPT said:</h4><div class="text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div data-conversation-screenshot-content="" class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn"><div class="flex max-w-full flex-col gap-4 [&amp;&gt;div:has([data-free-thinking-preview-answer=true])+:is(.text-message,.relative:has(&gt;.text-message))]:-mt-2 grow"><div data-message-author-role="assistant" data-message-id="47895426-2804-4593-8ca8-b1c0c36186be" dir="auto" data-message-model-slug="gpt-5-6" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden"><div class="LR5Y_W_content markdown prose dark:prose-invert wrap-break-word w-full dark markdown-new-styling"><p dir="auto" data-start="0" data-end="47">Great 👍 Let's finish the main visuals quickly.</p>
<h1 data-section-id="1acwkhr" dir="auto" data-start="49" data-end="86">Step 11 — Churn by Internet Service</h1>
<p dir="auto" data-start="88" data-end="113">This is our second chart.</p>
<ol data-start="115" data-end="313">
<li data-section-id="1m3snfo" data-start="115" data-end="176">
<p dir="auto" data-start="118" data-end="176">Click an empty area beside <strong data-start="145" data-end="175">Customer Churn by Contract</strong>.</p>
</li>
<li data-section-id="go9qtl" data-start="177" data-end="211">
<p dir="auto" data-start="180" data-end="211">Select <strong data-start="187" data-end="210">Clustered bar chart</strong>.</p>
</li>
<li data-section-id="bfp3gq" data-start="212" data-end="313">
<p dir="auto" data-start="215" data-end="220">Drag:</p>
<ul data-start="224" data-end="313">
<li data-section-id="1ainjsb" data-start="224" data-end="256">
<p dir="auto" data-start="226" data-end="256"><code data-start="226" data-end="243">InternetService</code> → <strong data-start="246" data-end="256">Y-axis</strong></p>
</li>
<li data-section-id="11bgb51" data-start="260" data-end="287">
<p dir="auto" data-start="262" data-end="287"><code data-start="262" data-end="274">customerID</code> → <strong data-start="277" data-end="287">X-axis</strong></p>
</li>
<li data-section-id="1y2xm2h" data-start="291" data-end="313">
<p dir="auto" data-start="293" data-end="313"><code data-start="293" data-end="300">Churn</code> → <strong data-start="303" data-end="313">Legend</strong></p>
</li>
</ul>
</li>
</ol>
<p dir="auto" data-start="315" data-end="378">This counts customers and separates them into <strong data-start="361" data-end="377">Yes/No churn</strong>.</p>
<p dir="auto" data-start="380" data-end="400">Change the title to:</p>
<p dir="auto" data-start="402" data-end="440"><strong data-start="402" data-end="440">Customer Churn by Internet Service</strong></p>
<hr data-start="442" data-end="445">
<h1 data-section-id="80elmv" dir="auto" data-start="447" data-end="474">Step 12 — Churn by Tenure</h1>
<p dir="auto" data-start="476" data-end="561">For this one, we'll create simple tenure groups so the chart is easier to understand.</p>
<h3 data-section-id="1ektvm1" dir="auto" data-start="563" data-end="586">Create a new column</h3>
<p dir="auto" data-start="588" data-end="594">Go to:</p>
<p dir="auto" data-start="596" data-end="621"><strong data-start="596" data-end="621">Modeling → New column</strong></p>
<p dir="auto" data-start="623" data-end="629">Paste:</p>
<pre class="overflow-visible! px-0!" data-start="631" data-end="818"><div class="relative w-full mt-4 mb-1"><div class=""><div class="contents"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="relative h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback"><div class="select-none sticky z-2 top-(--sticky-padding-top)"><div class="flex w-full items-center justify-between py-1.5 ps-4 pe-1.5 font-sans md:ps-5 bg-(--code-block-surface)"><div class="flex max-w-[75%] min-w-0 cursor-default items-center text-sm font-medium justify-self-start text-token-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-sm me-2.5 shrink-0"><use href="/cdn/assets/sprites-core-07247886.svg#72c6a7" fill="currentColor"></use></svg>DAX</div><div class="flex flex-row items-center gap-0.5 justify-self-end"><button type="button" class="flex gap-1 items-center select-none py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-07247886.svg#7fccfb" fill="currentColor"></use></svg></button></div></div></div><div class="pointer-events-none absolute inset-x-4 top-12 bottom-4"><div class="pointer-events-none sticky z-40 shrink-0 z-1!" style="top: calc(calc(var(--sticky-padding-top) + 48px) - 1px * 3); margin-bottom: calc(-4px); height: calc(4px); mask-image: linear-gradient(transparent 25%, white 75%);"><div class="sticky bg-token-border-light" style="top: calc(var(--sticky-padding-top) + 48px); height: 1px;"></div></div></div><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class=""><div class="relative"><div class="" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span>Tenure Group =
SWITCH(
    TRUE(),
    Customers[tenure] &lt;= 12, "0–1 Year",
    Customers[tenure] &lt;= 24, "1–2 Years",
    Customers[tenure] &lt;= 48, "2–4 Years",
    "4+ Years"
)</span></code></pre></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></div></div></pre>
<p dir="auto" data-start="820" data-end="836">Press <strong data-start="826" data-end="835">Enter</strong>.</p>
<p dir="auto" data-start="838" data-end="878">Now create a <strong data-start="851" data-end="877">Clustered column chart</strong>.</p>
<p dir="auto" data-start="880" data-end="885">Drag:</p>
<ul data-start="887" data-end="967">
<li data-section-id="sdxru6" data-start="887" data-end="916">
<p dir="auto" data-start="889" data-end="916"><code data-start="889" data-end="903">Tenure Group</code> → <strong data-start="906" data-end="916">X-axis</strong></p>
</li>
<li data-section-id="bhkk90" data-start="917" data-end="944">
<p dir="auto" data-start="919" data-end="944"><code data-start="919" data-end="931">customerID</code> → <strong data-start="934" data-end="944">Y-axis</strong></p>
</li>
<li data-section-id="1y2xm2h" data-start="945" data-end="967">
<p dir="auto" data-start="947" data-end="967"><code data-start="947" data-end="954">Churn</code> → <strong data-start="957" data-end="967">Legend</strong></p>
</li>
</ul>
<p dir="auto" data-start="969" data-end="975">Title:</p>
<p dir="auto" data-start="977" data-end="1005"><strong data-start="977" data-end="1005">Customer Churn by Tenure</strong></p>
<h3 data-section-id="fh0v9c" dir="auto" data-start="1007" data-end="1020">Important</h3>
<p dir="auto" data-start="1022" data-end="1089">Power BI might arrange the groups alphabetically. That's not ideal.</p>
<p dir="auto" data-start="1091" data-end="1149">We'll fix the order later if necessary. For now, continue.</p>
<hr data-start="1151" data-end="1154">
<h1 data-section-id="1q5qiv2" dir="auto" data-start="1156" data-end="1191">Step 13 — Churn by Payment Method</h1>
<p dir="auto" data-start="1193" data-end="1218">Create a <strong data-start="1202" data-end="1217">Donut chart</strong>.</p>
<p dir="auto" data-start="1220" data-end="1225">Drag:</p>
<ul data-start="1227" data-end="1285">
<li data-section-id="gfd7z2" data-start="1227" data-end="1257">
<p dir="auto" data-start="1229" data-end="1257"><code data-start="1229" data-end="1244">PaymentMethod</code> → <strong data-start="1247" data-end="1257">Legend</strong></p>
</li>
<li data-section-id="b6zdor" data-start="1258" data-end="1285">
<p dir="auto" data-start="1260" data-end="1285"><code data-start="1260" data-end="1272">customerID</code> → <strong data-start="1275" data-end="1285">Values</strong></p>
</li>
</ul>
<p dir="auto" data-start="1287" data-end="1297">Then drag:</p>
<ul data-start="1299" data-end="1337">
<li data-section-id="sqg1i0" data-start="1299" data-end="1337">
<p dir="auto" data-start="1301" data-end="1337"><code data-start="1301" data-end="1308">Churn</code> → <strong data-start="1311" data-end="1337">Filters on this visual</strong></p>
</li>
</ul>
<p dir="auto" data-start="1339" data-end="1346">Select:</p>
<p dir="auto" data-start="1348" data-end="1355"><strong data-start="1348" data-end="1355">Yes</strong></p>
<p dir="auto" data-start="1357" data-end="1414">This makes the donut show <strong data-start="1383" data-end="1413">only customers who churned</strong>.</p>
<p dir="auto" data-start="1416" data-end="1422">Title:</p>
<p dir="auto" data-start="1424" data-end="1463"><strong data-start="1424" data-end="1463">Churned Customers by Payment Method</strong></p>
<hr data-start="1465" data-end="1468">
<h1 data-section-id="qktcum" dir="auto" data-start="1470" data-end="1506">Step 14 — Monthly Charges vs Churn</h1>
<p dir="auto" data-start="1508" data-end="1544">Create a <strong data-start="1517" data-end="1543">Clustered column chart</strong>.</p>
<p dir="auto" data-start="1546" data-end="1551">Drag:</p>
<ul data-start="1553" data-end="1607">
<li data-section-id="pzy8su" data-start="1553" data-end="1575">
<p dir="auto" data-start="1555" data-end="1575"><code data-start="1555" data-end="1562">Churn</code> → <strong data-start="1565" data-end="1575">X-axis</strong></p>
</li>
<li data-section-id="1va9bpd" data-start="1576" data-end="1607">
<p dir="auto" data-start="1578" data-end="1607"><code data-start="1578" data-end="1594">MonthlyCharges</code> → <strong data-start="1597" data-end="1607">Y-axis</strong></p>
</li>
</ul>
<p dir="auto" data-start="1609" data-end="1666">Power BI may automatically use <strong data-start="1640" data-end="1665">Sum of MonthlyCharges</strong>.</p>
<p dir="auto" data-start="1668" data-end="1681">Change it to:</p>
<p dir="auto" data-start="1683" data-end="1694"><strong data-start="1683" data-end="1694">Average</strong></p>
<p dir="auto" data-start="1696" data-end="1773">by clicking the dropdown beside <code data-start="1728" data-end="1744">MonthlyCharges</code> in the visual and selecting:</p>
<p dir="auto" data-start="1775" data-end="1786"><strong data-start="1775" data-end="1786">Average</strong></p>
<p dir="auto" data-start="1788" data-end="1794">Title:</p>
<p dir="auto" data-start="1796" data-end="1832"><strong data-start="1796" data-end="1832">Average Monthly Charges by Churn</strong></p>
<hr data-start="1834" data-end="1837">
<h1 data-section-id="6bbzcm" dir="auto" data-start="1839" data-end="1869">Step 15 — Add Your 3 Slicers</h1>
<p dir="auto" data-start="1871" data-end="1912">Now we'll make the dashboard interactive.</p>
<h3 data-section-id="1x76jf9" dir="auto" data-start="1914" data-end="1926">Slicer 1</h3>
<p dir="auto" data-start="1928" data-end="1948">Click an empty area.</p>
<p dir="auto" data-start="1950" data-end="1968">Select <strong data-start="1957" data-end="1967">Slicer</strong>.</p>
<p dir="auto" data-start="1970" data-end="1975">Drag:</p>
<p dir="auto" data-start="1977" data-end="1987"><code data-start="1977" data-end="1987">Contract</code></p>
<p dir="auto" data-start="1989" data-end="1997">into it.</p>
<h3 data-section-id="1x76jfa" dir="auto" data-start="1999" data-end="2011">Slicer 2</h3>
<p dir="auto" data-start="2013" data-end="2035">Create another slicer.</p>
<p dir="auto" data-start="2037" data-end="2042">Drag:</p>
<p dir="auto" data-start="2044" data-end="2052"><code data-start="2044" data-end="2052">gender</code></p>
<p dir="auto" data-start="2054" data-end="2062">into it.</p>
<h3 data-section-id="1x76jfb" dir="auto" data-start="2064" data-end="2076">Slicer 3</h3>
<p dir="auto" data-start="2078" data-end="2100">Create another slicer.</p>
<p dir="auto" data-start="2102" data-end="2107">Drag:</p>
<p dir="auto" data-start="2109" data-end="2126"><code data-start="2109" data-end="2126">InternetService</code></p>
<p dir="auto" data-start="2128" data-end="2136">into it.</p>
<p dir="auto" data-start="2138" data-end="2195">Your dashboard now allows the user to select things like:</p>
<blockquote data-start="2197" data-end="2228">
<p dir="auto" data-start="2199" data-end="2228">Month-to-month → Female → DSL</p>
</blockquote>
<p dir="auto" data-start="2230" data-end="2289">and <strong data-start="2234" data-end="2289">all your charts and KPIs will update automatically.</strong></p>
<hr data-start="2291" data-end="2294">
<h1 data-section-id="vlzwon" dir="auto" data-start="2296" data-end="2340">Your dashboard now has everything required</h1>
<p dir="auto" data-start="2342" data-end="2358">You should have:</p>
<h3 data-section-id="ynjip3" dir="auto" data-start="2360" data-end="2368">KPIs</h3>
<ul data-start="2369" data-end="2445">
